+package review
+
+import "os"
+
+// bakeoffNoTriage is set only by the bakeoff, to measure what triage's model
+// judgment removes. It is never set in a shipped configuration.
+func bakeoffNoTriage() bool {
+	return os.Getenv("NITPICK_BAKEOFF_NO_TRIAGE") != ""
+}

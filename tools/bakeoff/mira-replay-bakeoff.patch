+def _bakeoff_strip_sections(text: str) -> str:
+    """Bakeoff only: drop named sections of the rendered system prompt.
+
+    The sections are cut between their headings, so the rest of the prompt is
+    byte-identical. Unset, this returns the text unchanged.
+    """
+
+    def cut(text: str, first: str, stop: str) -> str:
+        start = text.find(first)
+        end = text.find(stop)
+        if start == -1 or end == -1 or end < start:
+            raise ValueError(f"bakeoff ablation: {first!r} .. {stop!r} not found")
+        return text[:start] + text[end:]
+
+    if os.environ.get("MIRA_BAKEOFF_NO_HEURISTICS"):
+        text = cut(text, "## Cross-Boundary Tracing", "## Do NOT Suggest")
+    if os.environ.get("MIRA_BAKEOFF_NO_EXCLUSIONS"):
+        text = cut(text, "## Do NOT Suggest", "## Severity Guide")
+    return text
+

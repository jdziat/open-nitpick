@@ -0,0 +1,28 @@
+package openaicompat
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	llms "github.com/nocturnium/llm-go-sdk/v6"
+)
+
+func TestAnAssistantTurnsReasoningIsSentBackWithIt(t *testing.T) {
+	msgs := []llms.Message{
+		{Role: llms.RoleUser, Content: "q"},
+		{Role: llms.RoleAssistant, Content: "", Reasoning: &llms.ReasoningContent{Content: "I should read app.go first."},
+			ToolCalls: []llms.ToolCall{{ID: "1", Type: llms.ToolTypeFunction, Function: &llms.FunctionCall{Name: "read_file", Arguments: "{}"}}}},
+		{Role: llms.RoleTool, ToolCallID: "1", Content: "file"},
+	}
+	out, err := json.Marshal(ConvertMessages(msgs))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(out), `"reasoning":"I should read app.go first."`) {
+		t.Errorf("assistant reasoning missing from %s", out)
+	}
+	if strings.Count(string(out), `"reasoning"`) != 1 {
+		t.Errorf("reasoning appears on a message that had none: %s", out)
+	}
+}

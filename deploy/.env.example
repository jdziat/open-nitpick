# The database password. It goes into a URL, so use letters and digits only:
#   openssl rand -hex 24
NITPICK_DB_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD

# Whitespace-separated name:role:sha256:<hash> entries. The server holds only
# hashes, so this file is not a credential.
#
# Make a hash from a secret, without it touching shell history:
#   printf %s "$SECRET" | docker run --rm -i ghcr.io/nitpick-oss/nitpick-server -hash
# or, from a checkout:
#   printf %s "$SECRET" | go run ./cmd/nitpick-server -hash
#
# Roles: authoritative, provisional, read.
NITPICK_NOTARY_TOKENS="ci:authoritative:sha256:REPLACE_WITH_64_HEX dev:read:sha256:REPLACE_WITH_64_HEX"

  "linters": {
    "implementation": "Whole completed analyzer sets persist ordered findings and full coverage metadata alongside model-stage progress. Findings include all 11 engine-owned fields and preserve an explicit zero confidence. Empty findings are reusable only with proved ran/no-target statuses. Failed or unproved skipped stages rerun.",
    "separate_accounting": "Report.ReusedAnalyzerStages and JSON reused_analyzer_stages count local stages. Report.ReusedRequests remains model results only. Under the forge progress size limit, paid model results outrank local analyzer output.",
    "scope": "Opt-in resume on incremental reviews with a prior progress carrier; no default recipe or model change. Same complete diff, head, policy and stable analyzer input identity required. Inputs are rechecked after execution before saving.",
    "eligible": "Isolated native Ruff, or native golangci-lint in module mode with cgo off, bounded -tags/-mod flags, a local toolchain and tracked in-tree replacement modules. Native executable content, analyzer policy and effective environment are bound; application binary version is not.",
    "fallbacks": [
      "Dirty/untracked/ignored files, tracked symlinks/submodules or hidden Git assume-unchanged/skip-worktree flags",
      "Unavailable/non-native/unsupported analyzers or external configuration/rules",
      "Go workspaces, untracked or external local module replacements, cgo, overlays/modfiles/toolexec/pkgdir flags",
      "External cache/package drivers, including automatic gopackagesdriver discovery on PATH"
    ],
    "ruff_output_policy": "Eligible checkpoint runs disable Ruff native caching so .ruff_cache cannot change the input identity. Resume-disabled analysis retains its existing native cache behavior. An existing ignored .ruff_cache makes the checkout ineligible and analysis runs fresh.",
    "toolchain": "Identity probing uses the same analyzerEnv(GOTOOLCHAIN=local) and binary resolution as actual Go execution, so repository toolchain hints cannot trigger a download.",
    "component_review": {
      "reviewer": "CTO agent persona",
      "status": "GO for the linter checkpoint only",
      "closed_blockers": [
        "Hidden source changes via Git index flags",
        "External Go flags/drivers, including automatic PATH driver discovery",
        "Ambient toolchain downloading during identity probing"
      ],
      "not_approved": "Whole-program readiness"
    },
